{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "PageGloss",
  "version": "1.2.0",
  "default_locale": "zh_CN",
  "description": "__MSG_appDesc__",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/Self-Identity/PageGloss",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "src/shared/messages.js",
        "src/shared/i18n.js",
        "src/shared/storage.js",
        "src/content/matcher.js",
        "src/content/card.js",
        "src/content/main.js"
      ],
      "css": ["src/content/inject.css"]
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["src/content/inject.css"],
      "matches": ["http://*/*", "https://*/*"]
    },
    {
      "resources": ["docs/help.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
