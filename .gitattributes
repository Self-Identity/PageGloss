# Keep the deploy scripts usable on every platform:
# - .bat/.cmd/.ps1 must stay CRLF (checked by tools/check.js)
# - .sh must stay LF and executable
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
